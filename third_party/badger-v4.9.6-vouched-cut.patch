new file mode 100644
index 0000000..dc9e4fd
--- /dev/null
+++ b/flushed_log.go
@@ -0,0 +1,264 @@
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-18: a flushed memtable's log is
+ * removed, durably, after the MANIFEST names its table and before the table
+ * is in a level, and Open removes a log whose table the MANIFEST already
+ * names instead of replaying it (hoardDB's BUG-0858). See
+ * hoardDB/third_party/README.md. 2026-11-19: Close also keeps the table of a
+ * flush whose MANIFEST change failed (hoardDB's BUG-0868).
+ */
+
+package badger
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"sync/atomic"
+
+	"github.com/dgraph-io/ristretto/v2/z"
+)
+
+// Why. Badger removed a flushed memtable's log when the memtable's last
+// reference went, with no directory fsync, and nothing synced that log at the
+// flush. A reader or a sync capture kept it on disk after its table was in
+// level 0, where a compaction can drop a delete marker together with the
+// versions under it. After a crash the log was replayed: under hoardDB's
+// vouched cut its entries at or below the vouched version were kept and the
+// delete above it discarded, and after a power cut the log could hold a set
+// without the delete that followed. Either way a deleted key came back.
+//
+// The order that closes it, per flush: the table is synced (CreateTable), the
+// MANIFEST change naming it is synced (levelsController.nameLevel0Table), the
+// log is unlinked and the directory fsynced (DB.retireMemTableLog), and only
+// then is the table inserted into level 0 (levelsController.insertLevel0Table),
+// where a compaction can pick it. So no compaction ever reads a table whose
+// log a crash can leave on disk. A crash inside that window can leave the log
+// beside its named table; Open removes such a log, durably, before any
+// compaction starts (DB.removeLogsOfNamedTables).
+
+// retireRemoveLog and retireSyncDir remove a flushed log and fsync the store
+// directory; tests replace them to inject a failure or to stop inside the
+// retirement.
+var (
+	retireRemoveLog = os.Remove
+	retireSyncDir   = syncDir
+)
+
+// retireMemTableLog removes the log of a memtable whose table the MANIFEST
+// names, and makes the removal durable. The name goes now whatever references
+// the memtable has: a reader reads the skiplist, which never needed the log,
+// and a sync capture msyncs the unlinked file; the last reference releases it
+// (logFile.closeRetired). A failed unlink can be retried. A failed directory
+// fsync cannot: after one, a later fsync can succeed without the unlink having
+// reached the disk, so the failure is kept and returned by every retry, the
+// table stays out of level 0, the flush loop refuses writes (change 4), and
+// the next Open makes the removal durable: it removes the log if it is still
+// there, and fsyncs the directory in any case before compactions start
+// (removeLogsOfNamedTables). The memtable is never the active one: the
+// flusher takes only rotated memtables, and DropPrefix rotates the active one
+// out before it flushes it.
+func (db *DB) retireMemTableLog(mt *memTable) error {
+	if mt.retireFailed != nil {
+		return mt.retireFailed
+	}
+	if !mt.logRetired.Load() {
+		if err := retireRemoveLog(mt.wal.path); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("while removing the flushed memtable log %s: %w", mt.wal.path, err)
+		}
+		mt.logRetired.Store(true)
+		db.flushStep(FlushLogUnlinked)
+	}
+	if err := retireSyncDir(db.opt.Dir); err != nil {
+		mt.retireFailed = fmt.Errorf("syncing the directory %s after removing the flushed memtable log %s failed, "+
+			"so the removal is not known to be durable; its table stays out of level 0 until the store is reopened: %w",
+			db.opt.Dir, mt.wal.path, err)
+		return mt.retireFailed
+	}
+	return nil
+}
+
+// releaseNamedTables runs in DB.close after the flusher has stopped: a
+// memtable whose table the MANIFEST names and whose log's removal never became
+// durable keeps that table out of every level. The table is closed and kept on
+// disk: the next Open loads it from the MANIFEST and removes the log
+// (removeLogsOfNamedTables). DecrRef would delete the file of a named table.
+// It returns how many such tables it closed: their memtables' writes are all in
+// them, and Close says so instead of "their logs are replayed".
+func (db *DB) releaseNamedTables() (int, error) {
+	var errs []error
+	released := 0
+	for _, mt := range db.imm {
+		// A table whose naming failed is kept too, and not counted: its log
+		// was never removed (memTable.failedNaming, BUG-0868).
+		if mt.failedNaming != nil {
+			if err := mt.failedNaming.Close(-1); err != nil {
+				errs = append(errs, fmt.Errorf("closing table %d, whose naming in the MANIFEST failed: %w", mt.failedNaming.ID(), err))
+			}
+			mt.failedNaming = nil
+		}
+		if mt.named == nil {
+			continue
+		}
+		if err := mt.named.Close(-1); err != nil {
+			errs = append(errs, fmt.Errorf("closing table %d, which the MANIFEST names and no level holds: %w", mt.named.ID(), err))
+		}
+		mt.named = nil
+		released++
+	}
+	return released, errors.Join(errs...)
+}
+
+// removeLogsOfNamedTables runs in Open after the levels are loaded and before
+// any compaction or flush starts. A replayed log whose every entry is at or
+// below the tables' highest version belongs to a memtable whose table the
+// MANIFEST already names: commit versions are written in order and memtables
+// are flushed in order, so a memtable never flushed holds only versions above
+// every table's. Such a log is what a crash inside the retirement leaves (its
+// table is in no compaction's output yet) or, in a store last run before this
+// change, a log a reader kept past its flush. Its entries are in the tables or
+// were dropped there by a compaction, as they may be; replayed, they would be
+// flushed into a second table that can outlive a compaction of the first and
+// bring back what that compaction dropped. The logs go.
+//
+// Then the directory is fsynced, whether or not this open removed anything
+// (review F2): an unlink an earlier process applied, by a flush whose directory
+// fsync failed or by an open that failed after its own unlink, can be in the
+// page cache only, and this open no longer sees that log. Without the fsync,
+// compactions would start on its table, and a power cut afterwards could bring
+// the log back beside tables they have cut. One directory fsync per open.
+//
+// Relies on the version order: DB.RunValueLogGC, DB.Load, the stream writer,
+// DB.BanNamespace and managed mode write at versions they choose. Under a
+// vouched cut they are refused; managed mode skips the removal (not the
+// fsync); hoardDB's other stores call none of them (DropPrefix keeps versions).
+func (db *DB) removeLogsOfNamedTables() error {
+	if db.opt.InMemory {
+		return nil
+	}
+	var removed []string
+	var tablesHighest uint64
+	if !db.opt.managedTxns && len(db.imm) > 0 {
+		for _, info := range db.Tables() {
+			tablesHighest = max(tablesHighest, info.MaxVersion)
+		}
+		kept := db.imm[:0]
+		for _, mt := range db.imm {
+			if mt.maxVersion > tablesHighest {
+				kept = append(kept, mt)
+				continue
+			}
+			if err := retireRemoveLog(mt.wal.path); err != nil && !errors.Is(err, os.ErrNotExist) {
+				return fmt.Errorf("while removing the memtable log %s, whose table the MANIFEST already names: %w", mt.wal.path, err)
+			}
+			mt.logRetired.Store(true)
+			removed = append(removed, mt.wal.path)
+			mt.DecrRef()
+		}
+		db.imm = kept
+	}
+	if err := retireSyncDir(db.opt.Dir); err != nil {
+		return fmt.Errorf("while syncing the directory %s before compactions start (memtable logs this open removed, "+
+			"whose tables the MANIFEST already names: %v): %w", db.opt.Dir, removed, err)
+	}
+	if len(removed) > 0 {
+		db.vouchedReport.LogsOfNamedTables = len(removed)
+		db.opt.Infof("Removed %d memtable logs whose tables the MANIFEST already names (at or below version %d): %v",
+			len(removed), tablesHighest, removed)
+	}
+	return nil
+}
+
+// flushTestHook is set only by tests (SetFlushTestHook).
+var flushTestHook atomic.Pointer[func(*DB)]
+
+// SetFlushTestHook installs a function DB.flushMemtable calls with its DB
+// before it flushes each memtable, and returns the function that puts the
+// previous hook back. A hook that blocks holds that DB's flusher in front of
+// the flush: the memtable stays in db.imm and its log stays on disk, the only
+// copy of its commits. The hook is package-wide; a test that sets it compares
+// the DB (DB.Opts().Dir) and returns at once for any other. Production code
+// must not call it. hoardDB.
+func SetFlushTestHook(hook func(db *DB)) (restore func()) {
+	var next *func(*DB)
+	if hook != nil {
+		next = &hook
+	}
+	previous := flushTestHook.Swap(next)
+	return func() { flushTestHook.Store(previous) }
+}
+
+// openCompactionsHook is called by Open, with the store directory, right
+// before it starts the compactions; tests replace it to see what has happened
+// by then (the open step's directory fsync must be before it).
+var openCompactionsHook = func(dir string) {}
+
+// FlushStep names a point inside a flush at which FlushStepHook is called. The
+// points are the ones a crash can land between, in the order the flush takes
+// them (DB.flushToNamedTable).
+type FlushStep string
+
+// The steps of a flush to disk, in order.
+const (
+	// FlushTableSynced: the table file is written and synced; the MANIFEST does
+	// not name it and the memtable's log is on disk.
+	FlushTableSynced FlushStep = "table synced"
+	// FlushTableNamed: the MANIFEST change naming the table is synced; the log
+	// is still on disk.
+	FlushTableNamed FlushStep = "table named"
+	// FlushLogUnlinked: the log is unlinked; the directory is not yet fsynced.
+	FlushLogUnlinked FlushStep = "log unlinked"
+	// FlushDirectorySynced: the directory is fsynced after the unlink; the
+	// table is in no level yet.
+	FlushDirectorySynced FlushStep = "directory synced"
+	// FlushTableInLevelZero: the table is in level 0, where a compaction can
+	// pick it; the flush is complete except for advancing db.imm.
+	FlushTableInLevelZero FlushStep = "table in level 0"
+)
+
+// flushStepHook is set only by tests (SetFlushStepHook).
+var flushStepHook atomic.Pointer[func(step FlushStep, db *DB)]
+
+// SetFlushStepHook installs a function the flusher calls, on its own
+// goroutine, at each FlushStep of a flush to disk, and returns the function
+// that puts the previous hook back. The flusher does nothing else while the
+// hook runs, so a test can copy the store directory at exactly that point: the
+// images of every instant a crash can land at. The hook is package-wide; a
+// test compares DB.Opts().Dir and returns at once for any other store.
+// Production code must not call it. hoardDB.
+func SetFlushStepHook(hook func(step FlushStep, db *DB)) (restore func()) {
+	var next *func(step FlushStep, db *DB)
+	if hook != nil {
+		next = &hook
+	}
+	previous := flushStepHook.Swap(next)
+	return func() { flushStepHook.Store(previous) }
+}
+
+func (db *DB) flushStep(step FlushStep) {
+	if hook := flushStepHook.Load(); hook != nil {
+		(*hook)(step, db)
+	}
+}
+
+// closeRetired releases a log whose name the flush already removed
+// (DB.retireMemTableLog): it unmaps the file, drops its pages (an unlinked
+// file needs no writeback) and closes it.
+func (lf *logFile) closeRetired() error {
+	if lf.Fd == nil {
+		return nil
+	}
+	if err := z.Munmap(lf.Data); err != nil {
+		return fmt.Errorf("while munmap file: %s, error: %w", lf.Fd.Name(), err)
+	}
+	lf.Data = nil
+	if err := lf.Fd.Truncate(0); err != nil {
+		return fmt.Errorf("while truncate file: %s, error: %w", lf.Fd.Name(), err)
+	}
+	if err := lf.Fd.Close(); err != nil {
+		return fmt.Errorf("while close file: %s, error: %w", lf.Fd.Name(), err)
+	}
+	return nil
+}
diff --git a/flushed_log_order_test.go b/flushed_log_order_test.go
new file mode 100644
index 0000000..bc9a8b2
--- /dev/null
+++ b/flushed_log_order_test.go
@@ -0,0 +1,97 @@
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-18: the gate tests of the open step
+ * (DB.removeLogsOfNamedTables) and the flush step hook. The open step removes
+ * every replayed log whose highest version is at or below the tables' highest,
+ * which is sound only while commit versions are issued in write order. These
+ * tests pin what keeps that true. See hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"math"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// TestManagedModeKeepsTheLogOfACommitBelowTheTables writes at versions the
+// caller chooses, out of order: a table holds version 10, and the next
+// memtable's log holds a commit at version 5. The open step would take that log
+// for the leftover of a flush whose table the MANIFEST names and remove it, and
+// the commit would be lost; managed mode must skip the removal (the review's
+// version-order gate: DB.removeLogsOfNamedTables). Red when the managed-mode
+// condition is removed from the step.
+func TestManagedModeKeepsTheLogOfACommitBelowTheTables(t *testing.T) {
+	dir := t.TempDir()
+	opt := cutTestOptions(dir)
+	db, err := OpenManaged(opt)
+	require.NoError(t, err)
+	closeAtCleanup(t, db)
+
+	writeAt := func(commitVersion uint64, prefix string, count int) {
+		batch := db.NewWriteBatchAt(commitVersion)
+		for i := range count {
+			require.NoError(t, batch.Set([]byte(prefix+string(rune('a'+i%26))+string(rune('a'+i/26))), make([]byte, 512)))
+		}
+		require.NoError(t, batch.Flush())
+	}
+	first := activeMemTable(db)
+	for round := 0; activeMemTable(db) == first; round++ {
+		require.Less(t, round, 1000, "the first memtable never rotated")
+		writeAt(10, "high-", 64)
+	}
+	waitUntilNoImmutables(t, db)
+	var tablesHighest uint64
+	for _, info := range db.Tables() {
+		tablesHighest = max(tablesHighest, info.MaxVersion)
+	}
+	require.Equal(t, uint64(10), tablesHighest, "SCENARIO NOT REACHED: the flushed table does not hold version 10")
+
+	writeAt(5, "late-", 1)
+	require.NoError(t, db.Sync())
+	imageDir := writeImage(t, imageAt(t, dir))
+
+	reopened, err := OpenManaged(opt.WithDir(imageDir).WithValueDir(imageDir))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, reopened.Close()) }()
+	txn := reopened.NewTransactionAt(math.MaxUint64, false)
+	defer txn.Discard()
+	_, err = txn.Get([]byte("late-aa"))
+	require.NoError(t, err, "a commit at version 5, in a log beside a table holding version 10, was removed by the open step "+
+		"in managed mode, where commit versions are the caller's and the step's premise does not hold")
+}
+
+// TestALegacyDropPrefixKeepsTheVersionOrderTheOpenStepRelies is the one call
+// of hoardDB's legacy store that rewrites tables behind the flusher's back
+// (DB.DropPrefix); it keeps the versions it finds and the next commit takes a
+// version above every table's, so a log written after a drop is never at or
+// below the tables' highest version and the open step keeps it. If a drop ever
+// reset or lowered versions, this commit would be lost at the reopen.
+func TestALegacyDropPrefixKeepsTheVersionOrderTheOpenStepRelies(t *testing.T) {
+	dir := t.TempDir()
+	opt := cutTestOptions(dir)
+	db, err := Open(opt)
+	require.NoError(t, err)
+	closeAtCleanup(t, db)
+
+	setKey(t, db, "drop-1")
+	setKey(t, db, "keep-1")
+	require.NoError(t, commitUntilRotatedFrom(db, activeMemTable(db), "fill"))
+	waitUntilNoImmutables(t, db)
+	require.NoError(t, db.DropPrefix([]byte("drop-")))
+	setKey(t, db, "after-the-drop")
+	require.NoError(t, db.Sync())
+	imageDir := writeImage(t, imageAt(t, dir))
+
+	reopened, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, reopened.Close()) }()
+	require.True(t, hasKey(t, reopened, "after-the-drop"), "a commit after a DropPrefix is gone after a reopen: the open step took its "+
+		"log for the leftover of a flushed memtable")
+	require.True(t, hasKey(t, reopened, "keep-1"))
+	require.False(t, hasKey(t, reopened, "drop-1"), "the dropped key is back")
+}
diff --git a/flushed_log_retire_linux_test.go b/flushed_log_retire_linux_test.go
new file mode 100644
index 0000000..e3d241d
--- /dev/null
+++ b/flushed_log_retire_linux_test.go
@@ -0,0 +1,92 @@
+//go:build linux
+
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-18: BUG-0858's fix under a reader and
+ * a parked sync (change 12, the flushed log's retirement). See
+ * hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// openDescriptorsOf returns the targets of this process's descriptors that
+// name path (an unlinked file reads "<path> (deleted)").
+func openDescriptorsOf(t *testing.T, path string) []string {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	require.NoError(t, err)
+	var open []string
+	for _, entry := range entries {
+		target, err := os.Readlink(filepath.Join("/proc/self/fd", entry.Name()))
+		if err == nil && strings.HasPrefix(target, path) {
+			open = append(open, target)
+		}
+	}
+	return open
+}
+
+// TestARetiredLogServesItsReaderAndAParkedSync retires a memtable's log while
+// a reader holds the memtable and a DB.SyncVouched that captured it is parked
+// before its msyncs. The sync then msyncs the unlinked mapping and succeeds,
+// the reader reads every key, and once both have let go the file is released:
+// no descriptor of this process names it.
+func TestARetiredLogServesItsReaderAndAParkedSync(t *testing.T) {
+	for _, open := range retireOpens {
+		t.Run(open.name, func(t *testing.T) {
+			dir := t.TempDir()
+			db, err := Open(open.tune(cutTestOptions(dir)))
+			require.NoError(t, err)
+			closeAtCleanup(t, db)
+			first := activeMemTable(db)
+			logPath := first.wal.path
+			for i := range 8 {
+				setKey(t, db, fmt.Sprintf("held-%d", i))
+			}
+
+			letGo := holdFlushesOf(t, dir)
+			require.NoError(t, commitUntilRotatedFrom(db, first, "rotate"))
+			reader := db.NewTransaction(false)
+			pin := reader.NewIterator(DefaultIteratorOptions)
+
+			parked, resume := make(chan struct{}), make(chan struct{})
+			restore := SetSyncTestHooks(SyncTestHooks{AfterCapture: func() {
+				close(parked)
+				<-resume
+			}})
+			defer restore()
+			synced := make(chan error, 1)
+			go func() {
+				_, err := db.SyncVouched()
+				synced <- err
+			}()
+			<-parked
+			letGo()
+			waitUntilNoImmutables(t, db)
+			_, statErr := os.Stat(logPath)
+			require.ErrorIs(t, statErr, os.ErrNotExist, "the flushed log is still on disk while a reader and a sync hold its memtable")
+			close(resume)
+			require.NoError(t, <-synced, "a sync that captured the memtable failed after its log was removed")
+
+			found := 0
+			for pin.Seek([]byte("held-")); pin.ValidForPrefix([]byte("held-")); pin.Next() {
+				found++
+			}
+			require.Equal(t, 8, found, "the reader of the retired memtable lost keys")
+			pin.Close()
+			reader.Discard()
+			require.Empty(t, openDescriptorsOf(t, logPath), "the retired log is still open after its last reference went")
+		})
+	}
+}
diff --git a/flushed_log_retire_test.go b/flushed_log_retire_test.go
new file mode 100644
index 0000000..dd0d8d9
--- /dev/null
+++ b/flushed_log_retire_test.go
@@ -0,0 +1,762 @@
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-18: the tests of BUG-0858's fix
+ * (change 12, the flushed log's retirement). A flush removes its memtable's
+ * log, durably, after the MANIFEST names the table and before a compaction
+ * can see the table; Open removes a log whose table the MANIFEST already
+ * names instead of replaying it. See hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// retireOpens are the two opens the retirement applies to: with a vouched
+// cut (the ring store) and without (the legacy store, OpenBadgerKV).
+var retireOpens = []struct {
+	name string
+	tune func(Options) Options
+}{
+	{"vouched", func(o Options) Options { return o.WithVouchedCut(0) }},
+	{"legacy", func(o Options) Options { return o }},
+}
+
+// namedButNotVisible returns the ids of the tables the MANIFEST names that
+// are in no level: a flush's table between its MANIFEST change and its
+// insertion into level 0.
+func namedButNotVisible(db *DB) []uint64 {
+	visible := map[uint64]bool{}
+	for _, table := range db.Tables() {
+		visible[table.ID] = true
+	}
+	db.manifest.appendLock.Lock()
+	defer db.manifest.appendLock.Unlock()
+	var ids []uint64
+	for id := range db.manifest.manifest.Tables {
+		if !visible[id] {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+// namedTableCount returns how many tables the MANIFEST names.
+func namedTableCount(db *DB) int {
+	db.manifest.appendLock.Lock()
+	defer db.manifest.appendLock.Unlock()
+	return len(db.manifest.manifest.Tables)
+}
+
+// waitForANamedTableOutOfTheLevels waits until the MANIFEST names a table
+// that is in no level and returns its id.
+func waitForANamedTableOutOfTheLevels(t *testing.T, db *DB) uint64 {
+	t.Helper()
+	deadline := time.Now().Add(30 * time.Second)
+	for {
+		if ids := namedButNotVisible(db); len(ids) == 1 {
+			return ids[0]
+		}
+		require.True(t, time.Now().Before(deadline), "no flush named a table and stopped before level 0 within 30 s")
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// heldMemTable returns the memtable the flusher holds at the level-0 stall
+// after holdTheFlusher: the oldest in db.imm.
+func heldMemTable(t *testing.T, db *DB) *memTable {
+	t.Helper()
+	db.lock.RLock()
+	defer db.lock.RUnlock()
+	require.NotEmpty(t, db.imm, "no memtable waits for its flush")
+	return db.imm[0]
+}
+
+// TestAFlushedLogIsGoneBeforeItsTableIsVisible holds a flush where its table
+// is named in the MANIFEST and not yet in level 0 (the level-0 stall, nothing
+// compacts), with a reader holding the memtable. The memtable's log must be
+// gone from the directory by then: once the table is in a level a compaction
+// can drop a delete marker of it, and a log left on disk, replayed after a
+// crash, brings back the set that marker shadowed (BUG-0858). The log goes
+// whatever references the memtable has; the reader keeps reading the
+// skiplist.
+func TestAFlushedLogIsGoneBeforeItsTableIsVisible(t *testing.T) {
+	for _, open := range retireOpens {
+		t.Run(open.name, func(t *testing.T) {
+			opt := open.tune(cutTestOptions(t.TempDir()))
+			db, err := Open(opt)
+			require.NoError(t, err)
+			closeAtCleanup(t, db)
+			holdTheFlusher(t, db)
+			held := heldMemTable(t, db)
+			reader := db.NewTransaction(false)
+			pin := reader.NewIterator(DefaultIteratorOptions)
+			t.Cleanup(func() {
+				pin.Close()
+				reader.Discard()
+			})
+
+			// The flush unlinks the log right after its MANIFEST change, so a
+			// look in between can still see it; it must be gone within moments,
+			// while the table still waits for level 0.
+			table := waitForANamedTableOutOfTheLevels(t, db)
+			var statErr error
+			for deadline := time.Now().Add(5 * time.Second); time.Now().Before(deadline); time.Sleep(5 * time.Millisecond) {
+				if _, statErr = os.Stat(held.wal.path); statErr != nil {
+					break
+				}
+			}
+			require.ErrorIs(t, statErr, os.ErrNotExist, "the MANIFEST names table %d, which waits for level 0, and the log %s "+
+				"of the memtable it was flushed from is still on disk 5 s later", table, filepath.Base(held.wal.path))
+			require.Equal(t, []uint64{table}, namedButNotVisible(db), "the table went into a level while the test watched")
+
+			pin.Rewind()
+			require.True(t, pin.Valid(), "the reader that holds the flushed memtable reads nothing")
+		})
+	}
+}
+
+// TestALogLeftBesideItsNamedTableIsNotReplayed builds the image of a crash
+// between the MANIFEST change that names a flush's table and the durable
+// removal of its memtable's log: the table named and in no level, the log on
+// disk, at its bytes as of the last sync (a power cut) or whole (a kill). The
+// reopened store must not replay that log: its entries are all in the named
+// table, and replayed (under the cut, without the delete above the vouched
+// version) and flushed again it makes a second table that can outlive a
+// compaction of the first, bringing back the set that compaction dropped with
+// its delete marker.
+func TestALogLeftBesideItsNamedTableIsNotReplayed(t *testing.T) {
+	for _, open := range retireOpens {
+		for _, whole := range []bool{false, true} {
+			name := open.name + "/log as of the sync"
+			if whole {
+				name = open.name + "/log whole"
+			}
+			t.Run(name, func(t *testing.T) {
+				dir := t.TempDir()
+				opt := open.tune(cutTestOptions(dir))
+				db, err := Open(opt)
+				require.NoError(t, err)
+				closeAtCleanup(t, db)
+				fillLevelZeroToStall(t, db)
+
+				leftover := activeMemTable(db)
+				setKey(t, db, "doomed")
+				vouched, err := db.SyncVouched()
+				require.NoError(t, err)
+				logAtSync, err := os.ReadFile(leftover.wal.path)
+				require.NoError(t, err)
+				require.NoError(t, db.Update(func(txn *Txn) error { return txn.Delete([]byte("doomed")) }))
+				// The log's bytes after the last commit it takes are all it will
+				// ever hold: a rotated memtable is never written again.
+				var logWhole []byte
+				for batch := 0; activeMemTable(db) == leftover; batch++ {
+					require.Less(t, batch, 1000, "the memtable never rotated")
+					logWhole, err = os.ReadFile(leftover.wal.path)
+					require.NoError(t, err)
+					require.NoError(t, commitBatch(db, fmt.Sprintf("rotate-%04d", batch)))
+				}
+				waitForANamedTableOutOfTheLevels(t, db)
+				// The flush removes the log right after naming the table; copying the
+				// directory meanwhile could list the log and then not find it. The
+				// image gets the log back from the bytes read above either way.
+				for deadline := time.Now().Add(5 * time.Second); time.Now().Before(deadline); time.Sleep(5 * time.Millisecond) {
+					if _, statErr := os.Stat(leftover.wal.path); statErr != nil {
+						break
+					}
+				}
+
+				leftLog := logAtSync
+				if whole {
+					leftLog = logWhole
+				}
+				image := writeImage(t, imageAt(t, dir), storeImage{filepath.Base(leftover.wal.path): leftLog})
+				reopenOpt := opt.WithDir(image).WithValueDir(image)
+				if opt.vouchedCut {
+					reopenOpt = reopenOpt.WithVouchedCut(vouched)
+				}
+				reopened, err := Open(reopenOpt)
+				require.NoError(t, err)
+				defer func() { require.NoError(t, reopened.Close()) }()
+				// The image's active log is replayed too, legitimately, on the legacy
+				// open (the cut empties it on the vouched one); only the leftover
+				// must not be.
+				leftoverName := filepath.Base(leftover.wal.path)
+				reopened.lock.RLock()
+				var replayed []string
+				for _, mt := range reopened.imm {
+					replayed = append(replayed, filepath.Base(mt.wal.path))
+				}
+				reopened.lock.RUnlock()
+				require.NotContains(t, replayed, leftoverName, "the reopened store replayed the log %s, whose table the MANIFEST "+
+					"already names, into a memtable it will flush into a second table", leftoverName)
+				_, statErr := os.Stat(filepath.Join(image, leftoverName))
+				require.ErrorIs(t, statErr, os.ErrNotExist, "the log %s, whose table the MANIFEST names, is still on disk after the open", leftoverName)
+				require.False(t, hasKey(t, reopened, "doomed"), "the deleted key is back after the reopen")
+			})
+		}
+	}
+}
