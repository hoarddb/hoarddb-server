--- /dev/null
+++ b/vouched.go
@@ -0,0 +1,185 @@
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-17: the vouched cut (WithVouchedCut,
+ * DB.SyncVouched, DB.VouchedCutReport, ErrVouchedCutRefused) and its test
+ * seams. See hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/dgraph-io/badger/v4/y"
+)
+
+// VouchedCutReport says what the vouched cut did at Open. hoardDB.
+type VouchedCutReport struct {
+	Vouched       uint64 // the version the store was opened with (WithVouchedCut)
+	Kept          uint64 // the highest version kept: the larger of Vouched and the tables' highest version
+	DiscardedTxns uint64 // commits above Vouched discarded from the memtable logs
+	LogsTruncated int    // memtable logs cut short and fsynced
+	LogsRemoved   int    // memtable logs the cut emptied, deleted
+	// LogsOfNamedTables counts the memtable logs Open removed, durably,
+	// because the MANIFEST already names their tables (a crash inside a
+	// flushed log's retirement; DB.removeLogsOfNamedTables). Set with or
+	// without WithVouchedCut.
+	LogsOfNamedTables int
+}
+
+// VouchedCutReport returns what the vouched cut did at Open; for a store
+// opened without WithVouchedCut, only LogsOfNamedTables is set. hoardDB.
+func (db *DB) VouchedCutReport() VouchedCutReport {
+	return db.vouchedReport
+}
+
+// ErrVouchedCutRefused is wrapped by the error a call gets when it would
+// write out of version order in a store opened with WithVouchedCut, and by
+// Open's refusal of the option with ReadOnly, InMemory or managed mode.
+// hoardDB.
+var ErrVouchedCutRefused = errors.New("refused under a vouched cut")
+
+// vouchedCutRefusal is the error of a call refused under a vouched cut. It
+// names the call and says why.
+type vouchedCutRefusal struct{ call string }
+
+func (r vouchedCutRefusal) Error() string {
+	return "this store was opened with a vouched cut (WithVouchedCut), which keeps commit versions in write order; " +
+		r.call + " would write out of that order, so it was refused"
+}
+
+func (r vouchedCutRefusal) Unwrap() error { return ErrVouchedCutRefused }
+
+// refuseUnderVouchedCut returns the refusal of call when the store was
+// opened with WithVouchedCut, and nil otherwise. The refused calls write
+// entries at versions they choose (DB.Load, the value-log GC's rewrite,
+// DB.BanNamespace at version 1) or drop data outside any commit
+// (DB.DropAll, DB.DropPrefix, the stream writer), so after them a version
+// no longer says which commits came before it, and the cut could drop
+// vouched data or keep a hole.
+func (db *DB) refuseUnderVouchedCut(call string) error {
+	if !db.opt.vouchedCut {
+		return nil
+	}
+	return vouchedCutRefusal{call: call}
+}
+
+// checkVouchedCutOptions refuses WithVouchedCut where the cut cannot hold:
+// a read-only open cannot truncate a log, an in-memory store has none, and
+// managed mode lets the caller choose commit versions, so version order is
+// no longer write order.
+func checkVouchedCutOptions(opt *Options) error {
+	if !opt.vouchedCut {
+		return nil
+	}
+	switch {
+	case opt.ReadOnly:
+		return fmt.Errorf("WithVouchedCut cannot be used with ReadOnly: the cut truncates the memtable logs at open, "+
+			"which a read-only open cannot do: %w", ErrVouchedCutRefused)
+	case opt.InMemory:
+		return fmt.Errorf("WithVouchedCut cannot be used with InMemory: an in-memory store has no memtable logs to cut: %w",
+			ErrVouchedCutRefused)
+	case opt.managedTxns:
+		return vouchedCutRefusal{call: "managed mode (OpenManaged)"}
+	}
+	return nil
+}
+
+// vouchedCutScan is the cut's state while Open replays the memtable logs,
+// oldest first (DB.openMemTables). hoardDB.
+type vouchedCutScan struct {
+	version uint64
+	// cutStarted is set once a log, this one or an earlier one, has handed
+	// over an entry above version. Versions are written in order, so from
+	// there on every entry must be above it.
+	cutStarted bool
+	// logCut and logCutOffset are the log being replayed: whether it holds an
+	// entry above version, and the offset of the first such entry, which is
+	// where its transaction starts (logFile.iterate hands a transaction over
+	// at its end marker, its first entry carrying the offset it starts at).
+	logCut       bool
+	logCutOffset uint32
+	// logsTruncated and logsRemoved count the logs the cut shortened and
+	// those it emptied; discardedTxns counts the commits it left out, one per
+	// version, lastDiscarded being the version of the last entry left out.
+	logsTruncated, logsRemoved   int
+	discardedTxns, lastDiscarded uint64
+}
+
+// startLog resets the state of the log being replayed.
+func (scan *vouchedCutScan) startLog() {
+	scan.logCut, scan.logCutOffset = false, 0
+}
+
+// discards reports whether the replay of the log at logPath must leave out
+// the entry at offset with the given key: every entry above the vouched
+// version is discarded. An entry at or below it after the cut point means
+// versions are out of write order (only the calls refused under the cut write
+// so), and cutting there would drop vouched data, so it fails the open.
+func (scan *vouchedCutScan) discards(key []byte, offset uint32, logPath string) (bool, error) {
+	version := y.ParseTs(key)
+	if version > scan.version {
+		if !scan.logCut {
+			scan.logCut, scan.logCutOffset, scan.cutStarted = true, offset, true
+		}
+		// A transaction's entries share its version and are handed over
+		// together, so a new version is a new commit.
+		if version != scan.lastDiscarded {
+			scan.discardedTxns, scan.lastDiscarded = scan.discardedTxns+1, version
+		}
+		return true, nil
+	}
+	if scan.cutStarted {
+		return false, fmt.Errorf("the memtable log %s holds version %d after the vouched cut point, where every "+
+			"version must be above the vouched version %d: commit versions are out of write order (a call that is "+
+			"refused under the cut wrote this store), and cutting here would drop vouched data", logPath, version, scan.version)
+	}
+	return false, nil
+}
+
+// cutSyncFile fsyncs a memtable log the cut truncated (T5 replaces it).
+var cutSyncFile = func(f *os.File) error { return f.Sync() }
+
+// cutSyncDir fsyncs the store directory after the cut (T5 replaces it).
+var cutSyncDir = syncDir
+
+// syncValueLogHook is set only by tests. DB.SyncVouched calls it after the
+// memtable logs' msyncs and before the value log's, so a test can hold a sync
+// where a power cut leaves a value-log pointer durable without its bytes.
+var syncValueLogHook func()
+
+// syncAfterUnlockHook is set only by tests. DB.SyncVouched calls it right
+// after it releases db.lock, once both captures are taken and before any
+// msync. Unlike syncCaptureHook, which runs under that lock, a commit can
+// return while it runs: every commit takes db.lock.Lock in
+// DB.ensureRoomForWrite.
+var syncAfterUnlockHook func()
+
+// SyncTestHooks are the test seams of DB.Sync and DB.SyncVouched; a nil
+// field is no hook. hoardDB.
+type SyncTestHooks struct {
+	// AfterCapture runs right after the sync has captured the memtables and
+	// released db.lock, before any msync. A commit started here can return,
+	// and the memtable can rotate, while the sync waits.
+	AfterCapture func()
+	// BeforeValueLogSync runs after the memtable logs' msyncs and before the
+	// value log's.
+	BeforeValueLogSync func()
+}
+
+// SetSyncTestHooks installs the hooks and returns the function that puts the
+// previous ones back. It is a test seam, exported only because tests in other
+// packages (hoardDB's storage and cluster tests) need it; production code
+// must not call it. The hooks are package-wide, so a test that sets them must
+// not run in parallel with another that syncs. hoardDB.
+func SetSyncTestHooks(h SyncTestHooks) (restore func()) {
+	previousAfterCapture, previousBeforeValueLogSync := syncAfterUnlockHook, syncValueLogHook
+	syncAfterUnlockHook, syncValueLogHook = h.AfterCapture, h.BeforeValueLogSync
+	return func() {
+		syncAfterUnlockHook, syncValueLogHook = previousAfterCapture, previousBeforeValueLogSync
+	}
+}
diff --git a/vouched_cut_linux_test.go b/vouched_cut_linux_test.go
new file mode 100644
index 0000000..7dd1d27
--- /dev/null
+++ b/vouched_cut_linux_test.go
@@ -0,0 +1,328 @@
+//go:build linux
+
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-17: the tests of the vouched cut
+ * (WithVouchedCut, DB.SyncVouched, change 12) that build images of a live
+ * store, as the sync-order tests do. See hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// versionOf returns the version key is visible at in db.
+func versionOf(t *testing.T, db *DB, key string) uint64 {
+	t.Helper()
+	var version uint64
+	require.NoError(t, db.View(func(txn *Txn) error {
+		item, err := txn.Get([]byte(key))
+		if err != nil {
+			return fmt.Errorf("reading %s: %w", key, err)
+		}
+		version = item.Version()
+		return nil
+	}))
+	return version
+}
+
+// commitAt commits key on its own and returns the version it took.
+func commitAt(t *testing.T, db *DB, key string) uint64 {
+	t.Helper()
+	setKey(t, db, key)
+	return versionOf(t, db, key)
+}
+
+// visibleVersions returns every user key of db with the version it is
+// visible at.
+func visibleVersions(t *testing.T, db *DB) map[string]uint64 {
+	t.Helper()
+	versions := map[string]uint64{}
+	require.NoError(t, db.View(func(txn *Txn) error {
+		iterator := txn.NewIterator(IteratorOptions{})
+		defer iterator.Close()
+		for iterator.Rewind(); iterator.Valid(); iterator.Next() {
+			versions[string(iterator.Item().KeyCopy(nil))] = iterator.Item().Version()
+		}
+		return nil
+	}))
+	return versions
+}
+
+// TestEntriesAboveTheMarkerAreGoneAndStayGone checks the cut at open (I-1,
+// I-2): commits above the vouched version are not visible after the open,
+// the report counts them, and once the store has taken their versions again
+// for new commits and vouched those, a second image does not bring them back.
+// The flusher is held (no compactors, level 0 at its stall) so the log the
+// cut truncated is still a log when the second image is taken: left
+// untruncated, it would replay the old commits under the new, higher vouched
+// version (the spec's probe: commits 7 and 8 returned).
+func TestEntriesAboveTheMarkerAreGoneAndStayGone(t *testing.T) {
+	held := func(o Options) Options {
+		return o.WithNumCompactors(0).WithNumLevelZeroTables(1).WithNumLevelZeroTablesStall(2)
+	}
+	db, opt := openSyncLockTestDB(t, func(o Options) Options { return held(o).WithVouchedCut(0) })
+	closeAtCleanup(t, db)
+	fillLevelZeroToStall(t, db)
+
+	vouchedKeys := []string{"vouched-1", "vouched-2", "vouched-3", "vouched-4", "vouched-5", "vouched-6"}
+	for _, key := range vouchedKeys {
+		setKey(t, db, key)
+	}
+	vouched, err := db.SyncVouched()
+	require.NoError(t, err)
+	require.Equal(t, versionOf(t, db, vouchedKeys[len(vouchedKeys)-1]), vouched,
+		"SyncVouched did not return the version of the last commit before it")
+	discardedKeys := []string{"discarded-1", "discarded-2"}
+	var discardedVersions []uint64
+	for _, key := range discardedKeys {
+		discardedVersions = append(discardedVersions, commitAt(t, db, key))
+	}
+
+	firstImage := writeImage(t, imageAt(t, opt.Dir))
+	first, err := Open(held(opt).WithDir(firstImage).WithValueDir(firstImage).WithVouchedCut(vouched))
+	require.NoError(t, err)
+	closeAtCleanup(t, first)
+	for _, key := range vouchedKeys {
+		require.True(t, hasKey(t, first, key), "%s, at or below the vouched version %d, is gone after the cut", key, vouched)
+	}
+	for _, key := range discardedKeys {
+		require.False(t, hasKey(t, first, key), "%s, above the vouched version %d, is visible after the cut", key, vouched)
+	}
+	firstReport := first.VouchedCutReport()
+
+	// The versions the cut discarded are handed out again.
+	againKeys := []string{"again-1", "again-2"}
+	for i, key := range againKeys {
+		require.Equal(t, discardedVersions[i], commitAt(t, first, key),
+			"SCENARIO NOT REACHED: %s did not take the discarded version %d again", key, discardedVersions[i])
+	}
+	vouchedAgain, err := first.SyncVouched()
+	require.NoError(t, err)
+	require.Equal(t, discardedVersions[len(discardedVersions)-1], vouchedAgain)
+
+	secondImage := writeImage(t, imageAt(t, firstImage))
+	second, err := Open(opt.WithDir(secondImage).WithValueDir(secondImage).WithVouchedCut(vouchedAgain).
+		WithNumCompactors(2).WithNumLevelZeroTables(5).WithNumLevelZeroTablesStall(15))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, second.Close()) }()
+	for _, key := range discardedKeys {
+		require.False(t, hasKey(t, second, key), "%s, discarded by the first cut, came back after a second image "+
+			"under the vouched version %d: the truncation was not durable", key, vouchedAgain)
+	}
+	for _, key := range append(vouchedKeys, againKeys...) {
+		require.True(t, hasKey(t, second, key), "%s is gone after the second image", key)
+	}
+	require.Equal(t, VouchedCutReport{Vouched: vouched, Kept: vouched, DiscardedTxns: 2, LogsTruncated: 1}, firstReport,
+		"the first open's report does not count the two commits it discarded")
+}
+
+// TestLargeValueUnderAnUnfinishedSyncIsReplayedWhole is BUG-0827's route (c)
+// at the store: a value in the value log whose pointer reached the disk in a
+// memtable log that a sync made durable, while the value log's own msync had
+// not run. A power cut between the two msyncs leaves the pointer without its
+// bytes. The commit is above the vouched version, because that sync never
+// reported, so the cut discards it and the node replays it from its log; here
+// the key must be absent, never present with an empty or unreadable value.
+func TestLargeValueUnderAnUnfinishedSyncIsReplayedWhole(t *testing.T) {
+	db, opt := openSyncLockTestDB(t, func(o Options) Options {
+		return o.WithValueLogFileSize(8 << 20).WithVouchedCut(0)
+	})
+	closeAtCleanup(t, db)
+
+	setKey(t, db, "before")
+	vouched, err := db.SyncVouched()
+	require.NoError(t, err)
+	atLastCompletedSync := imageAt(t, opt.Dir)
+
+	large := make([]byte, 1<<20)
+	for i := range large {
+		large[i] = byte(i%251 + 1)
+	}
+	require.NoError(t, db.Update(func(txn *Txn) error { return txn.Set([]byte("large"), large) }))
+
+	parked := make(chan struct{})
+	release := make(chan struct{})
+	var once, releaseOnce sync.Once
+	restore := syncValueLogHook
+	syncValueLogHook = func() {
+		once.Do(func() {
+			close(parked)
+			<-release
+		})
+	}
+	syncDone := make(chan error, 1)
+	go func() {
+		_, err := db.SyncVouched()
+		syncDone <- err
+	}()
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(release) })
+		<-syncDone
+		syncValueLogHook = restore
+	})
+	select {
+	case <-parked:
+	case <-time.After(60 * time.Second):
+		t.Fatal("SCENARIO NOT REACHED: DB.SyncVouched never reached the point between the active log's msync and the value log's")
+	}
+
+	// The memtable logs as they are now (synced), the value log as of the last
+	// completed sync.
+	imageDir := writeImage(t, imageAt(t, opt.Dir), atLastCompletedSync.only(isValueLogFile))
+	releaseOnce.Do(func() { close(release) })
+	require.NoError(t, <-syncDone)
+	syncDone <- nil
+
+	reopened, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir).WithVouchedCut(vouched))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, reopened.Close()) }()
+	require.True(t, hasKey(t, reopened, "before"))
+	err = reopened.View(func(txn *Txn) error {
+		item, err := txn.Get([]byte("large"))
+		if err != nil {
+			return err
+		}
+		read, err := item.ValueCopy(nil)
+		return fmt.Errorf("present with %d bytes of %d (read error: %v)", len(read), len(large), err)
+	})
+	if !errors.Is(err, ErrKeyNotFound) {
+		t.Fatalf("a 1 MiB value committed above the vouched version %d, whose value log was not synced at the cut, "+
+			"must be absent after the open, to be replayed whole by the node; it is %v", vouched, err)
+	}
+}
+
+// TestAFlushedTableVouchesWithoutASync checks that a flushed table vouches
+// what it holds with no sync and no marker: commits, a flush, more commits,
+// an image, an open with the vouched version 0. Exactly the commits up to the
+// table's highest version are visible (I-1, C = max(V, T)).
+func TestAFlushedTableVouchesWithoutASync(t *testing.T) {
+	db, opt := openSyncLockTestDB(t, func(o Options) Options { return o.WithNumCompactors(0).WithVouchedCut(0) })
+	closeAtCleanup(t, db)
+
+	require.NoError(t, writeUntilRotated(db, activeMemTable(db), "flushed"))
+	deadline := time.Now().Add(30 * time.Second)
+	for numImmutables(db) > 0 {
+		require.True(t, time.Now().Before(deadline), "the memtable flush did not finish")
+		time.Sleep(10 * time.Millisecond)
+	}
+	require.NoError(t, writeFill(db, "unflushed", 2))
+	lastVersion := versionOf(t, db, "unflushed-00001-63")
+	var tableMax uint64
+	for _, table := range db.Tables() {
+		tableMax = max(tableMax, table.MaxVersion)
+	}
+	require.NotZero(t, tableMax, "SCENARIO NOT REACHED: no table was flushed")
+	require.Less(t, tableMax, lastVersion, "SCENARIO NOT REACHED: every commit is in a table")
+	committed := visibleVersions(t, db)
+
+	imageDir := writeImage(t, imageAt(t, opt.Dir))
+	reopened, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir).WithVouchedCut(0))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, reopened.Close()) }()
+	visible := visibleVersions(t, reopened)
+	var gone, kept []string
+	for key, version := range committed {
+		_, isVisible := visible[key]
+		if version <= tableMax && !isVisible {
+			gone = append(gone, fmt.Sprintf("%s@%d", key, version))
+		}
+		if version > tableMax && isVisible {
+			kept = append(kept, fmt.Sprintf("%s@%d", key, version))
+		}
+	}
+	require.Zero(t, len(gone), "%d keys at or below the flushed table's highest version %d are gone after the open, among them %v",
+		len(gone), tableMax, gone[:min(3, len(gone))])
+	require.Zero(t, len(kept), "%d keys above the flushed table's highest version %d and the vouched version 0 are visible "+
+		"after the open, among them %v", len(kept), tableMax, kept[:min(3, len(kept))])
+	require.Equal(t, tableMax, reopened.VouchedCutReport().Kept)
+}
+
+// TestNoVersionAtOrBelowTheMarkerIsTakenAgain checks the version floor (I-3):
+// a store whose highest version is below the vouched version gives its next
+// commit a version above it, so that commit, unsynced, is discarded by the
+// next cut. Given a version at or below the marker, it would be kept as if a
+// sync had vouched it.
+func TestNoVersionAtOrBelowTheMarkerIsTakenAgain(t *testing.T) {
+	db, opt := openSyncLockTestDB(t, func(o Options) Options { return o.WithVouchedCut(0) })
+	highest := commitAt(t, db, "before")
+	require.NoError(t, db.Close())
+	vouched := highest + 100
+
+	reopened, err := Open(opt.WithVouchedCut(vouched))
+	require.NoError(t, err)
+	closeAtCleanup(t, reopened)
+	after := commitAt(t, reopened, "after")
+	require.Greater(t, after, vouched, "the first commit after an open under the vouched version %d took version %d", vouched, after)
+
+	imageDir := writeImage(t, imageAt(t, opt.Dir))
+	again, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir).WithVouchedCut(vouched))
+	require.NoError(t, err)
+	defer func() { require.NoError(t, again.Close()) }()
+	require.True(t, hasKey(t, again, "before"))
+	require.False(t, hasKey(t, again, "after"), "an unsynced commit after the open is kept by the next cut under the same vouched version")
+}
+
+// TestSyncVouchedReadsTheVersionBeforeTheCapture is T9 (f) at the store: the
+// version SyncVouched returns must be read before it captures the memtables.
+// A commit that returns after the capture and lands in a memtable rotated in
+// after it sits in a log this call never syncs, so the returned version must
+// not cover it; and every commit that returned before the call must be at or
+// below it (I-4). The commit and the rotation run inside
+// SyncTestHooks.AfterCapture, after the sync's read lock is released: under
+// that lock no commit can return (store-vouched-cut-build.md, review edit F1).
+func TestSyncVouchedReadsTheVersionBeforeTheCapture(t *testing.T) {
+	db, _ := openSyncLockTestDB(t, func(o Options) Options { return o.WithNumCompactors(0) })
+	closeAtCleanup(t, db)
+	early := commitAt(t, db, "early")
+
+	var once sync.Once
+	var hookRan, rotated bool
+	var late, capturedMax uint64
+	var hookErr error
+	restore := SetSyncTestHooks(SyncTestHooks{AfterCapture: func() {
+		once.Do(func() {
+			hookRan = true
+			captured := activeMemTable(db)
+			if hookErr = writeUntilRotated(db, captured, "rotate"); hookErr != nil {
+				return
+			}
+			if hookErr = db.Update(func(txn *Txn) error { return txn.Set([]byte("late"), []byte("after the capture")) }); hookErr != nil {
+				return
+			}
+			hookErr = db.View(func(txn *Txn) error {
+				item, err := txn.Get([]byte("late"))
+				if err != nil {
+					return err
+				}
+				late = item.Version()
+				return nil
+			})
+			rotated = activeMemTable(db) != captured
+			capturedMax = captured.maxVersion
+		})
+	}})
+	t.Cleanup(restore)
+
+	vouched, err := db.SyncVouched()
+	require.NoError(t, err)
+	require.True(t, hookRan, "SCENARIO NOT REACHED: SyncTestHooks.AfterCapture never ran inside DB.SyncVouched")
+	require.NoError(t, hookErr)
+	require.True(t, rotated, "SCENARIO NOT REACHED: the memtable did not rotate inside the hook")
+	require.Less(t, capturedMax, late, "SCENARIO NOT REACHED: the late commit is in the memtable the sync captured")
+
+	require.Less(t, vouched, late, "DB.SyncVouched returned version %d, which covers the commit at version %d that "+
+		"returned after its capture, in a memtable log it never synced: the version was read after the capture", vouched, late)
+	require.GreaterOrEqual(t, vouched, early, "DB.SyncVouched returned version %d, below the commit at version %d "+
+		"that returned before it was called", vouched, early)
+}
diff --git a/vouched_cut_test.go b/vouched_cut_test.go
new file mode 100644
index 0000000..ea2746b
--- /dev/null
+++ b/vouched_cut_test.go
@@ -0,0 +1,388 @@
+/*
+ * SPDX-FileCopyrightText: © 2017-2025 Istari Digital, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Added by the hoardDB project, 2026-11-17: the tests of the vouched cut
+ * (WithVouchedCut, change 12) that do not depend on the page cache, and the
+ * image helper the cut's tests share. See hoardDB/third_party/README.md.
+ */
+
+package badger
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// storeImage is the bytes of every regular file of a store directory as of
+// one instant, copied at that instant. An image of what a power cut can leave
+// is assembled from such copies, file by file, and never by rewriting a file:
+// a test that synthesised a log or a value log from what it remembers would
+// test its own model, not the store.
+type storeImage map[string][]byte
+
+// imageAt copies every regular file of dir now. The MANIFEST is copied first,
+// for copyDirImage's reason: a table is created and synced before the MANIFEST
+// names it, so every table the copied MANIFEST names is already on disk when
+// the directory is listed.
+func imageAt(t *testing.T, dir string) storeImage {
+	t.Helper()
+	image := storeImage{}
+	read := func(name string) {
+		content, err := os.ReadFile(filepath.Join(dir, name))
+		require.NoError(t, err, "copying %s into an image", name)
+		image[name] = content
+	}
+	read(ManifestFilename)
+	entries, err := os.ReadDir(dir)
+	require.NoError(t, err)
+	for _, entry := range entries {
+		if !entry.Type().IsRegular() || entry.Name() == ManifestFilename || entry.Name() == lockFile {
+			continue
+		}
+		read(entry.Name())
+	}
+	return image
+}
+
+// only returns the files of the image whose names keep accepts.
+func (image storeImage) only(keep func(name string) bool) storeImage {
+	kept := storeImage{}
+	for name, content := range image {
+		if keep(name) {
+			kept[name] = content
+		}
+	}
+	return kept
+}
+
+func isValueLogFile(name string) bool { return strings.HasSuffix(name, ".vlog") }
+
+// writeImage writes base's files into a new directory, each file of a later
+// override replacing the one of the same name, and returns the directory.
+func writeImage(t *testing.T, base storeImage, overrides ...storeImage) string {
+	t.Helper()
+	dir := t.TempDir()
+	merged := storeImage{}
+	for _, image := range append([]storeImage{base}, overrides...) {
+		for name, content := range image {
+			merged[name] = content
+		}
+	}
+	for name, content := range merged {
+		require.NoError(t, os.WriteFile(filepath.Join(dir, name), content, 0o600))
+	}
+	return dir
+}
+
+// cutTestOptions are small memtables and a small value threshold, as
+// openSyncLockTestDB's, in dir. Level 0 stalls at two tables and nothing
+// compacts, so once holdTheFlusher has run a rotated memtable stays in db.imm
+// and its log stays on disk.
+func cutTestOptions(dir string) Options {
+	return getTestOptions(dir).
+		WithMemTableSize(1 << 20).
+		WithValueThreshold(1 << 10).
+		WithValueLogFileSize(1 << 20).
+		WithNumCompactors(0).
+		WithNumLevelZeroTables(1).
+		WithNumLevelZeroTablesStall(2)
+}
+
+// commitBatch commits 64 inline 512-byte values under prefix in one
+// transaction.
+func commitBatch(db *DB, prefix string) error {
+	return db.Update(func(txn *Txn) error {
+		for i := range 64 {
+			if err := txn.Set([]byte(fmt.Sprintf("%s-%02d", prefix, i)), make([]byte, 512)); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+func activeMemTable(db *DB) *memTable {
+	db.lock.RLock()
+	defer db.lock.RUnlock()
+	return db.mt
+}
+
+// commitUntilRotatedFrom commits batches until mt is no longer the active
+// memtable. The batch that rotated it is in the new active memtable.
+func commitUntilRotatedFrom(db *DB, mt *memTable, prefix string) error {
+	for batch := 0; activeMemTable(db) == mt; batch++ {
+		if batch > 1000 {
+			return errors.New("the memtable never rotated")
+		}
+		if err := commitBatch(db, fmt.Sprintf("%s-%04d", prefix, batch)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// holdTheFlusher flushes memtables until level 0 holds two tables, then
+// rotates one more memtable and waits until the flusher has taken it. With
+// the options of cutTestOptions that flush waits at the level-0 stall, after
+// it has written its table and named it in the MANIFEST
+// (levelsController.addLevel0Table), so every memtable rotated after this
+// returns waits in the flush channel and keeps its log as the only copy of
+// its commits.
+func holdTheFlusher(t *testing.T, db *DB) {
+	t.Helper()
+	waitUntil := func(what string, done func() bool) {
+		deadline := time.Now().Add(30 * time.Second)
+		for !done() {
+			require.True(t, time.Now().Before(deadline), "%s did not happen within 30 s", what)
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	immutables := func() int {
+		db.lock.RLock()
+		defer db.lock.RUnlock()
+		return len(db.imm)
+	}
+	for batch := 0; db.lc.levels[0].numTables() < 2; batch++ {
+		require.NoError(t, commitUntilRotatedFrom(db, activeMemTable(db), fmt.Sprintf("hold-%04d", batch)))
+		waitUntil("a memtable flush", func() bool { return immutables() == 0 })
+	}
+	require.NoError(t, commitUntilRotatedFrom(db, activeMemTable(db), "held"))
+	waitUntil("the flusher taking the held memtable", func() bool { return len(db.flushChan) == 0 })
+}
+
+func setKey(t *testing.T, db *DB, key string) {
+	t.Helper()
+	require.NoError(t, db.Update(func(txn *Txn) error { return txn.Set([]byte(key), []byte("value of "+key)) }))
+}
+
+// hasKey reports whether key is visible in db; any error but a miss fails the
+// test.
+func hasKey(t *testing.T, db *DB, key string) bool {
+	t.Helper()
+	err := db.View(func(txn *Txn) error {
+		_, err := txn.Get([]byte(key))
+		return err
+	})
+	if errors.Is(err, ErrKeyNotFound) {
+		return false
+	}
+	require.NoError(t, err, "reading %s", key)
+	return true
+}
+
+// TestTheCutIsDurableBeforeTheFirstCommit checks that the cut's truncation and
+// removals are on disk before Open returns: the truncated log is fsynced
+// after its truncation, the directory after the removal of the log the cut
+// emptied. The versions the cut discards are handed out again, so if the old
+// bytes survived a crash right after the open, a later, higher vouched version
+// would vouch them (I-2). A seam test: cutSyncFile and cutSyncDir are
+// replaced by recorders, as manifest.go's syncFunc is in its tests; it does
+// not cut the power.
+func TestTheCutIsDurableBeforeTheFirstCommit(t *testing.T) {
+	dir := t.TempDir()
+	opt := cutTestOptions(dir).WithVouchedCut(0)
+	db, err := Open(opt)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	holdTheFlusher(t, db)
+
+	setKey(t, db, "vouched")
+	vouched, err := db.SyncVouched()
+	require.NoError(t, err)
+	// The first log keeps "vouched" and loses everything after it; the second
+	// holds only commits above the vouched version, so the cut empties it.
+	cutLog := activeMemTable(db)
+	setKey(t, db, "cut-from-the-first-log")
+	require.NoError(t, commitUntilRotatedFrom(db, cutLog, "rotate"))
+	removedLog := activeMemTable(db)
+	setKey(t, db, "in-the-removed-log")
+	cutLogName, removedLogName := filepath.Base(cutLog.wal.Fd.Name()), filepath.Base(removedLog.wal.Fd.Name())
+
+	image := imageAt(t, dir)
+	require.Contains(t, image, cutLogName, "SCENARIO NOT REACHED: the first log is not in the image (it was flushed)")
+	require.Contains(t, image, removedLogName)
+	imageDir := writeImage(t, image)
+
+	var events []string
+	var openReturned atomic.Bool
+	var cutLogSizeAtSync int64 = -1
+	var removedLogExistedAtDirSync bool
+	restoreFile, restoreDir := cutSyncFile, cutSyncDir
+	t.Cleanup(func() { cutSyncFile, cutSyncDir = restoreFile, restoreDir })
+	cutSyncFile = func(f *os.File) error {
+		name := filepath.Base(f.Name())
+		events = append(events, fmt.Sprintf("fsync %s (open returned: %v)", name, openReturned.Load()))
+		if name == cutLogName {
+			info, err := f.Stat()
+			if err != nil {
+				return err
+			}
+			cutLogSizeAtSync = info.Size()
+		}
+		return f.Sync()
+	}
+	cutSyncDir = func(syncedDir string) error {
+		events = append(events, fmt.Sprintf("fsync the directory (open returned: %v)", openReturned.Load()))
+		_, err := os.Stat(filepath.Join(syncedDir, removedLogName))
+		removedLogExistedAtDirSync = err == nil
+		return syncDir(syncedDir)
+	}
+
+	reopened, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir).WithVouchedCut(vouched).
+		WithNumCompactors(2).WithNumLevelZeroTables(5).WithNumLevelZeroTablesStall(15))
+	require.NoError(t, err)
+	openReturned.Store(true)
+	defer func() { require.NoError(t, reopened.Close()) }()
+
+	require.Equal(t, []string{
+		fmt.Sprintf("fsync %s (open returned: false)", cutLogName),
+		"fsync the directory (open returned: false)",
+	}, events, "the cut must fsync the truncated log and then the directory, both inside Open: "+
+		"without them a crash right after the open can bring the discarded commits back under versions handed out again")
+	require.Less(t, cutLogSizeAtSync, int64(len(image[cutLogName])),
+		"the log %s was fsynced before it was truncated (its size then was %d, %d in the image)",
+		cutLogName, cutLogSizeAtSync, len(image[cutLogName]))
+	require.False(t, removedLogExistedAtDirSync, "the directory was fsynced before the log %s the cut emptied was removed", removedLogName)
+	require.True(t, hasKey(t, reopened, "vouched"))
+	require.False(t, hasKey(t, reopened, "cut-from-the-first-log"))
+	require.False(t, hasKey(t, reopened, "in-the-removed-log"))
+}
+
+// TestTheCutIsOptIn pins I-7 at the store: without WithVouchedCut nothing of
+// the cut runs, so every log entry is kept; with it, the calls that write out
+// of version order are refused, and ReadOnly, InMemory and managed mode
+// refuse the option.
+func TestTheCutIsOptIn(t *testing.T) {
+	t.Run("without the option every log entry is kept", func(t *testing.T) {
+		dir := t.TempDir()
+		opt := cutTestOptions(dir)
+		db, err := Open(opt)
+		require.NoError(t, err)
+		defer func() { require.NoError(t, db.Close()) }()
+		setKey(t, db, "synced")
+		require.NoError(t, db.Sync())
+		setKey(t, db, "unsynced")
+		imageDir := writeImage(t, imageAt(t, dir))
+
+		reopened, err := Open(opt.WithDir(imageDir).WithValueDir(imageDir))
+		require.NoError(t, err)
+		defer func() { require.NoError(t, reopened.Close()) }()
+		require.True(t, hasKey(t, reopened, "synced"))
+		require.True(t, hasKey(t, reopened, "unsynced"), "a store opened without WithVouchedCut lost a log entry")
+		require.Equal(t, VouchedCutReport{}, reopened.VouchedCutReport())
+	})
+
+	refused := []struct {
+		call string
+		run  func(db *DB) error
+	}{
+		{"DB.RunValueLogGC", func(db *DB) error { return db.RunValueLogGC(0.5) }},
+		{"DB.Load", func(db *DB) error { return db.Load(bytes.NewReader(nil), 1) }},
+		{"DB.DropAll", func(db *DB) error { return db.DropAll() }},
+		{"DB.DropPrefix", func(db *DB) error { return db.DropPrefix([]byte("synced")) }},
+		// Cancel releases what a Prepare that was not refused took (writes
+		// blocked, compactions stopped); it is a no-op after a refusal.
+		{"StreamWriter.Prepare", func(db *DB) error {
+			writer := db.NewStreamWriter()
+			defer writer.Cancel()
+			return writer.Prepare()
+		}},
+		{"StreamWriter.PrepareIncremental", func(db *DB) error {
+			writer := db.NewStreamWriter()
+			defer writer.Cancel()
+			return writer.PrepareIncremental()
+		}},
+		{"DB.BanNamespace", func(db *DB) error { return db.BanNamespace(1) }},
+	}
+	for _, tc := range refused {
+		t.Run("refuses "+tc.call, func(t *testing.T) {
+			db, err := Open(cutTestOptions(t.TempDir()).WithVouchedCut(0))
+			require.NoError(t, err)
+			defer func() { require.NoError(t, db.Close()) }()
+			setKey(t, db, "synced")
+
+			err = tc.run(db)
+			require.ErrorIs(t, err, ErrVouchedCutRefused, "%s under a vouched cut", tc.call)
+			require.ErrorContains(t, err, tc.call)
+			require.True(t, hasKey(t, db, "synced"), "%s changed the store although it was refused", tc.call)
+			setKey(t, db, "after-the-refusal")
+		})
+	}
+
+	t.Run("managed mode refuses the option", func(t *testing.T) {
+		db, err := OpenManaged(cutTestOptions(t.TempDir()).WithVouchedCut(0))
+		if err == nil {
+			require.NoError(t, db.Close())
+		}
+		require.ErrorIs(t, err, ErrVouchedCutRefused)
+		require.ErrorContains(t, err, "managed mode")
+	})
+	t.Run("ReadOnly refuses the option", func(t *testing.T) {
+		dir := t.TempDir()
+		created, err := Open(cutTestOptions(dir))
+		require.NoError(t, err)
+		require.NoError(t, created.Close())
+		db, err := Open(cutTestOptions(dir).WithReadOnly(true).WithVouchedCut(0))
+		if err == nil {
+			require.NoError(t, db.Close())
+		}
+		require.ErrorIs(t, err, ErrVouchedCutRefused)
+		require.ErrorContains(t, err, "ReadOnly")
+	})
+	t.Run("InMemory refuses the option", func(t *testing.T) {
+		db, err := Open(DefaultOptions("").WithInMemory(true).WithLoggingLevel(WARNING).WithVouchedCut(0))
+		if err == nil {
+			require.NoError(t, db.Close())
+		}
+		require.ErrorIs(t, err, ErrVouchedCutRefused)
+		require.ErrorContains(t, err, "InMemory")
+	})
+}
+
+// TestLogFilesCreatedMovesWithEveryNewLogFile: [GUARD every memtable log and
+// value-log file the DB creates moves DB.LogFilesCreated, and Open starts it
+// above 0; red when a rotation or a new value-log file is not counted]. The
+// caller of SyncVouched fsyncs the directory only when the count moved, so a
+// file left out of it could lose its directory entry at a power cut while the
+// caller's marker vouches its commits (store-vouched-cut slice S-3).
+func TestLogFilesCreatedMovesWithEveryNewLogFile(t *testing.T) {
+	opt := DefaultOptions(t.TempDir()).WithLogger(nil).WithMemTableSize(1 << 20).
+		WithValueLogFileSize(1 << 20).WithValueThreshold(1 << 10)
+	db, err := Open(opt)
+	require.NoError(t, err)
+	defer func() { require.NoError(t, db.Close()) }()
+	atOpen := db.LogFilesCreated()
+	require.Positive(t, atOpen, "Open must count the files it found or created as not yet covered")
+
+	// The file ids only grow: the next memtable log's id and the newest value-log file's.
+	memFid, vlogFid := db.nextMemFid, db.vlog.maxFid
+	// Small values rotate the memtable; values above the threshold fill value-log files.
+	for i := 0; i < 2000; i++ {
+		require.NoError(t, db.Update(func(txn *Txn) error {
+			if err := txn.Set([]byte(fmt.Sprintf("small-%04d", i)), bytes.Repeat([]byte{'s'}, 900)); err != nil {
+				return err
+			}
+			return txn.Set([]byte(fmt.Sprintf("large-%04d", i)), bytes.Repeat([]byte{'l'}, 8<<10))
+		}))
+	}
+	db.lock.Lock()
+	createdLogs := db.nextMemFid - memFid
+	db.lock.Unlock()
+	db.vlog.filesLock.RLock()
+	createdVlogs := int(db.vlog.maxFid - vlogFid)
+	db.vlog.filesLock.RUnlock()
+	require.Positive(t, createdLogs, "SCENARIO NOT REACHED: the memtable never rotated")
+	require.Positive(t, createdVlogs, "SCENARIO NOT REACHED: no value-log file was created")
+	require.Equal(t, uint64(createdLogs)+uint64(createdVlogs), db.LogFilesCreated()-atOpen,
+		"the count did not move once per file created")
+}
