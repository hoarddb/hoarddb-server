+// HasBloomPrefixRule reports whether the table was built under prefix rule
+// ruleID: its index carries the rule's bit and it has a bloom filter, so the
+// filter holds a hash of the rule's prefix of every key the rule answers. A
+// table built before the rule existed, by a DB without it, or without a
+// filter reports false. hoardDB.
+func (t *Table) HasBloomPrefixRule(ruleID uint32) bool {
+	return t.hasBloomFilter && t.cheapIndex().BloomPrefixRules&BloomPrefixRuleBit(ruleID) != 0
+}
+
+// DoesNotHavePrefix returns true if and only if the table was built under
+// prefix rule ruleID and its bloom filter does not hold hash, the hash of a
+// prefix that rule names: the table then holds no key under the prefix. A
+// table that was not built under the rule always returns false ("may hold
+// it"), which is what keeps a table from before the rule readable. hoardDB.
+func (t *Table) DoesNotHavePrefix(hash uint32, ruleID uint32) bool {
+	if !t.HasBloomPrefixRule(ruleID) {
+		return false
+	}
+	index := t.fetchIndex()
+	return !y.Filter(index.BloomFilterBytes()).MayContain(hash)
+}
